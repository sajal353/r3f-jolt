{
  "name": "r3f-jolt",
  "version": "0.3.0",
  "type": "module",
  "description": "Jolt Physics Hooks for React-Three-Fiber",
  "keywords": [
    "jolt",
    "three",
    "react",
    "react-three-fiber",
    "r3f",
    "physics"
  ],
  "author": {
    "name": "Sajal",
    "email": "sajalbiswas353@gmail.com"
  },
  "homepage": "https://github.com/sajal353/r3f-jolt",
  "repository": {
    "type": "git",
    "url": "https://github.com/sajal353/r3f-jolt"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/r3f-jolt.js",
  "module": "./dist/r3f-jolt.js",
  "types": "./dist/r3f-jolt.d.ts",
  "exports": {
    ".": {
      "types": "./dist/r3f-jolt.d.ts",
      "import": "./dist/r3f-jolt.js",
      "default": "./dist/r3f-jolt.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite -c vite.demo.config.ts",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build -c vite.demo.config.ts",
    "preview": "vite preview -c vite.demo.config.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "jolt-physics": "^1.1.0",
    "react": ">=19 <19.3",
    "react-dom": ">=19 <19.3",
    "three": ">=0.156"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/test-renderer": "^9.1.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jolt-physics": "^1.1.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
